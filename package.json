{
  "name": "hire-trail",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"bun run --filter server dev\" \"bun run --filter client dev\"",
    "dev:server": "bun run --filter server dev",
    "dev:client": "bun run --filter client dev",
    "build": "bun run --filter server build && bun run --filter client build",
    "build:server": "bun run --filter server build",
    "build:client": "bun run --filter client build",
    "lint": "bun run --filter client lint",
    "typecheck": "bun run --filter server typecheck",
    "db:generate": "bun run --filter server db:generate",
    "db:migrate": "bun run --filter server db:migrate",
    "db:studio": "bun run --filter server db:studio",
    "db:up": "docker compose -f server/docker-compose.yml up -d",
    "db:down": "docker compose -f server/docker-compose.yml down",
    "db:seed": "bun run --filter server db:seed",
    "test": "bun run --filter client test && bun run --filter server test",
"test:coverage": "bun run --filter client test:coverage"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}